# Copy to .env and fill in. Everything has a working default except the API key.

# LLM (Anthropic). Leave empty to run with the built-in offline mock interviewer.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Security: generate with `openssl rand -hex 32`
SECRET_KEY=change-me-in-production

# Interview behaviour
MAX_QUESTIONS=8

# Infrastructure (defaults match docker-compose)
DATABASE_URL=postgresql+psycopg2://interviewiq:interviewiq@db:5432/interviewiq
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173

# Set true to run background jobs inline (no Redis/worker needed)
CELERY_EAGER=false
